% KARTÉZSKÁ SOUSTAVA – UČEBNICOVÉ PROSTŘEDÍ
% ===========================================
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

\newenvironment{axisgraph}[1][]{
  \begin{tikzpicture}
    \begin{axis}[
      xlabel={$x$}, ylabel={$y$},
      axis lines=center,
      tick align=inside,
      xmin=-5, xmax=5,
      ymin=-5, ymax=5,
      xtick distance=1,
      ytick distance=1,
      axis equal image,
      grid=none,
      major grid style={gray!40},
      minor grid style={gray!20},
      % --- Titulek pod grafem ---
      title style={
        font=\bfseries,
        yshift=-2.5ex,
        at={(0.5,0)},
        anchor=north
      },
      #1
    ]
}{
    \end{axis}
  \end{tikzpicture}
}




% --- Tabulky: centrované sloupcové typy ---
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}

% --- Číslování úloh podle sekcí ---
\newcounter{exercise}[section]  % resetuje se po každé sekci
\renewcommand{\theexercise}{\thesection.\arabic{exercise}} % formát 1.1, 1.2,...

% --- Část "Příklady k procvičení" ---
\newcommand{\exercisepart}{%
  \newpage
  \setcounter{exercise}{0} % <<< resetuje číslování úloh
  \begin{center}
    \Huge \bfseries Příklady k procvičení
  \end{center}
  \vspace{2em}
}


% --- Úlohy (dlouhé) ---
\newenvironment{exercise}[1][]{%
  \refstepcounter{exercise}%
  \par\noindent\textbf{Úloha \theexercise. #1}\par
}{\vspace{1em}}

% --- Krátké příklady v mřížce (balíček tasks) ---
\settasks{label=\alph*), label-format={\normalfont}, column-sep=1.5em}

\newenvironment{exerciseblock}[2][2]{% #1 = počet sloupců, #2 = název
  \refstepcounter{exercise}%
  \par\noindent\textbf{Úloha \theexercise. #2}\par
  \begin{tasks}(#1)
}{%
  \end{tasks}\vspace{1em}
}



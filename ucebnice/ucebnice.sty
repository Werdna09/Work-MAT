% --- Bannery nadpisů (zarovnané vlevo s paddingem) ---
\setlength{\fboxsep}{6pt}         % vnitřní odsazení v \colorbox
\newcommand{\bannerpad}{0.5em}    % levý padding textu

\newcommand{\SectionBanner}[1]{%
  \vspace{1.5ex}%
  \colorbox{pastelblue!80!black}{%
    \parbox{\dimexpr\textwidth-2\fboxsep}{%
      \raggedright \hspace*{\bannerpad}\Large\bfseries #1%
    }%
  }%
  \vspace{1.5ex}%
}

\newcommand{\SubsectionBanner}[1]{%
  \vspace{0.6ex}%
  \colorbox{pastelblue!90!black}{%
    \parbox{\dimexpr\textwidth-2\fboxsep}{%
      \raggedright \hspace*{\bannerpad}\bfseries #1%
    }%
  }%
  \vspace{0.6ex}%
}

\titleformat{\section}{\normalfont\color{black}}{}{0pt}{\SectionBanner}
\titlespacing*{\section}{0pt}{3ex plus 1ex minus .2ex}{2ex plus .2ex}

\titleformat{\subsection}{\normalfont\color{black}}{}{0pt}{\SubsectionBanner}
\titlespacing*{\subsection}{0pt}{2ex plus 0.5ex minus .2ex}{1.2ex plus .2ex}

% (Pokud chceš čísla kapitol v banneru: \thesection\quad #1; u podkapitol \thesubsection.)

% --- TikZ (pro quotebox linky apod.) ---
\usepackage{tikz}

% --- QUOTEBOX: 2 argumenty {citát}{autor} ---
\newenvironment{quotebox}[2]{%
  \begin{center}
  \vspace{1ex}
  \begin{tikzpicture}
    \draw[tableborder,thick] (0,0) -- (\textwidth,0);
  \end{tikzpicture}
  \par\vspace{1ex}
  {\itshape #1}%
  \par\vspace{1ex}
  \hfill --- {\normalfont #2}%
  \par\vspace{1ex}
  \begin{tikzpicture}
    \draw[tableborder,thick] (0,0) -- (\textwidth,0);
  \end{tikzpicture}
  \vspace{1ex}
  \end{center}
}{}

